# apps/mobile environment variables.
#
# Copy this file to `.env` and fill in real values.  Never commit a real `.env`.
# Public values are inlined into the JS bundle by Expo's `EXPO_PUBLIC_*` rules.
# Anything NOT prefixed `EXPO_PUBLIC_` is server-only on EAS Build (use
# `eas env:create` or EAS Secrets for those).

# --- Supabase -----------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://veolpjzmohfzcrfcrqvc.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend API --------------------------------------------------------------
# Base URL of the NestJS API (no trailing slash).  Defaults to localhost for
# `pnpm start` against a local backend.  Production URLs are injected by EAS.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# --- OAuth providers ----------------------------------------------------------
# These are public client IDs / Services IDs that ride along in the bundle.
# Secrets (client secrets, key files) belong in EAS Secrets, NOT here.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_APPLE_CLIENT_ID=
EXPO_PUBLIC_META_APP_ID=

# --- EAS Build-only (no EXPO_PUBLIC_ prefix = server-only) -------------------
# Apple Key ID, Google Service Account path, Slack webhook, etc.  Examples —
# uncomment and fill on EAS:
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_KEY_PATH=
# GOOGLE_SERVICES_JSON_PATH=
