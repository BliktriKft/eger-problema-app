# apps/api — required env (DO NOT COMMIT real values).
#
# Supabase: create a project at https://supabase.com, then copy:
#   - Settings → API → Project URL  → SUPABASE_URL
#   - Settings → API → service_role key (server-only!) → SUPABASE_SERVICE_ROLE_KEY
#   - Settings → API → anon public key → SUPABASE_ANON_KEY (web/mobile clients)
#
# Database: Settings → Database → Connection string → URI (use the "Direct"
# connection, NOT the pooler, for Prisma migrations).
#   - DATABASE_URL  — Postgres URI for the Prisma client (pooler, port 6543, recommended for runtime)
#   - DIRECT_URL    — Postgres URI for Prisma migrate (direct, port 5432)
# See ADR-0004 for the pooler/direct split rationale.

NODE_ENV=development
PORT=8000

# Supabase
SUPABASE_URL=https://veolpjzmohfzcrfcrqvc.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma / Postgres
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.veolpjzmohfzcrfcrqvc.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.veolpjzmohfzcrfcrqvc.supabase.co:5432/postgres

# CORS — comma-separated list of allowed origins (web dev, mobile uses no CORS).
CORS_ORIGIN=http://localhost:3000

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=info

# V2 phase — AI wiki (leave empty for MVP).
GOOGLE_NEWS_API_KEY=
NEWS_SCRAPER_USER_AGENT=EgerProblemaBot/0.1 (+contact)

# Scraper (website-ai)
SCRAPER_RATE_LIMIT_MS=5000
SCRAPER_HTTP_TIMEOUT_MS=15000

# Wiki — LLM provider selection (website-ai)
# mock    → no network call, deterministic Hungarian placeholder. Default.
#          Safe for CI, dev, and any deployment without a key.
# minimax → Anthropic-compatible SDK against https://api.minimax.io/anthropic
#          using MINIMAX_API_KEY + MINIMAX_MODEL. Switch on once the key
#          is provisioned in MiniMax Console.
# claude  → Official Anthropic SDK using ANTHROPIC_API_KEY + CLAUDE_MODEL.
#          Kept for editorial comparison / fallback.
# If a non-mock provider is selected without its key, the client logs a
# warning and degrades to mock automatically (graceful).
LLM_PROVIDER=mock

# MiniMax (optional, only used when LLM_PROVIDER=minimax)
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3

# Anthropic Claude (optional, only used when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# Wiki (website-ai)
WIKI_MAX_SOURCES=10
WIKI_MAX_BODY_CHARS=1500