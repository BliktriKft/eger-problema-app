{
  "name": "@eger/api",
  "version": "0.1.0",
  "private": true,
  "description": "Eger Város Probléma Térkép — NestJS backend (PostGIS + Supabase + Prisma).",
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "lint": "tsc --noEmit",
    "test": "echo \"no tests yet\" && exit 0",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "ts-node prisma/seed.ts",
    "docs:export": "pnpm run docs:export:ci",
    "docs:export:ci": "rm -rf dist tsconfig.tsbuildinfo; nest build; DATABASE_URL='postgresql://placeholder:***@localhost:5432/placeholder' DIRECT_URL='postgresql://placeholder:***@localhost:5432/placeholder' SUPABASE_URL='https://placeholder.supabase.co' SUPABASE_SERVICE_ROLE_KEY='placeholder' EXPORT_OPENAPI=1 node dist/main.js && cp openapi.json ../../packages/shared/openapi.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.41.0",
    "@eger/shared": "file:../../packages/shared",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.18.0",
    "@supabase/supabase-js": "^2.95.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^7.2.0",
    "nestjs-pino": "^4.4.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^11.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.18.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  }
}