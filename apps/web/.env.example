# apps/web/.env.example
# Copy to apps/web/.env and fill in real values. Never commit .env.
#
# The Next.js app reads all NEXT_PUBLIC_* at build time, so a change
# requires a `pnpm --filter @eger/web dev` restart (or rebuild).
#
# Quick recipe:
#   1. Provision a Supabase project (Settings → API).
#   2. Paste Project URL → NEXT_PUBLIC_SUPABASE_URL.
#   3. Paste the anon (public) key → NEXT_PUBLIC_SUPABASE_ANON_KEY.
#   4. Decide between API mode and demo mode:
#        - DEMO MODE (default for QA / offline): leave NEXT_PUBLIC_API_BASE_URL empty
#          and set NEXT_PUBLIC_USE_MOCK=true.  Every API call routes through
#          the in-memory mock (lib/mock-problems.ts) so the UI works
#          without the NestJS backend running.
#        - API MODE: set NEXT_PUBLIC_API_BASE_URL to your local backend
#          (default http://localhost:8000) and NEXT_PUBLIC_USE_MOCK=false.
#          The fetch wrapper in lib/api/client.ts hits the real endpoints.

# ── Supabase (required for any real auth flow) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── NestJS backend (apps/api) ─────────────────────────────────────────────
# Leave empty for demo mode.  In production this is the deployed API URL.
NEXT_PUBLIC_API_BASE_URL=

# Force the in-memory mock dataset regardless of NEXT_PUBLIC_API_BASE_URL.
# Useful for CI / Playwright runs where the backend isn't reachable.
# Allowed values: 1 | 0 | true | false (anything else falls back to
# the default — auto-detected from NEXT_PUBLIC_API_BASE_URL).
NEXT_PUBLIC_USE_MOCK=false
