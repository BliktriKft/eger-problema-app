{
  "$schema": "./schema.json",
  "shadow": {
    "none": { "value": "none",                                                       "type": "shadow", "description": "reset." },
    "sm":   { "value": "0 1px 2px 0 rgb(0 0 0 / 0.05)",                              "type": "shadow", "description": "subtle elevation — list rows on hover." },
    "md":   { "value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)", "type": "shadow", "description": "DEFAULT for cards, dropdowns, popovers." },
