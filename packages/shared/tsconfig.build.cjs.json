{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-cjs",
    "module": "CommonJS",
    "rootDir": "./src",
    "target": "ES2022",
    "moduleResolution": "Node",
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "dist-cjs", "**/*.spec.ts", "**/*.test.ts"]
}